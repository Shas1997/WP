STOPWATCH.JSX

import React, { Component } from 'react';

class Stopwatch extends Component {
  constructor(props) {
    super(props);
    this.state = {
      time: 0, // time in milliseconds
      isRunning: false,
      laps: []
    };
    this.timer = null;
  }

  componentDidMount() {
    // Lifecycle hook: Component mounted
  }

  componentDidUpdate(prevProps, prevState) {
    // If running status changes, handle interval setup/clear
    if (prevState.isRunning !== this.state.isRunning) {
      if (this.state.isRunning) {
        const startTime = Date.now() - this.state.time;
        this.timer = setInterval(() => {
          this.setState({
            time: Date.now() - startTime
          });
        }, 10); // Update every 10ms for centiseconds
      } else {
        clearInterval(this.timer);
      }
    }
  }

  componentWillUnmount() {
    clearInterval(this.timer);
  }

  formatTime = (ms) => {
    const totalCentiseconds = Math.floor(ms / 10);
    const centiseconds = totalCentiseconds % 100;
    const totalSeconds = Math.floor(totalCentiseconds / 100);
    const seconds = totalSeconds % 60;
    const minutes = Math.floor(totalSeconds / 60);

    const pad = (num) => String(num).padStart(2, '0');

    return `${pad(minutes)}:${pad(seconds)}.${pad(centiseconds)}`;
  };

  handleStart = () => {
    this.setState({ isRunning: true });
  };

  handleStop = () => {
    if (this.state.isRunning) {
      this.setState({ isRunning: false });
      // Automatically record current time as a lap on stop if desired, 
      // or just halt. The prompt states: "The 'Stop' button should halt 
      // the stopwatch timer and record the current time as a lap when clicked."
      const formattedCurrentTime = this.formatTime(this.state.time);
      this.setState((prevState) => ({
        laps: [...prevState.laps, formattedCurrentTime]
      }));
    }
  };

  handleReset = () => {
    clearInterval(this.timer);
    this.setState({
      time: 0,
      isRunning: false,
      laps: []
    });
  };

  handleAddLap = () => {
    if (this.state.isRunning) {
      const formattedCurrentTime = this.formatTime(this.state.time);
      this.setState((prevState) => ({
        laps: [...prevState.laps, formattedCurrentTime]
      }));
    }
  };

  render() {
    const { time, isRunning, laps } = this.state;

    return (
      <div className="stopwatch-container">
        <h1>Stopwatch</h1>
        <div className="timer-display">
          {this.formatTime(time)}
        </div>
        <div className="button-group">
          <button onClick={this.handleStart} disabled={isRunning}>
            Start
          </button>
          <button onClick={this.handleStop} disabled={!isRunning}>
            Stop
          </button>
          <button onClick={this.handleReset} disabled={isRunning}>
            Reset
          </button>
          <button onClick={this.handleAddLap} disabled={!isRunning}>
            Add Lap
          </button>
        </div>
        <div className="laps-container">
          <ul>
            {laps.map((lap, index) => (
              <li key={index}>{lap}</li>
            ))}
          </ul>
        </div>
      </div>
    );
  }
}

export default Stopwatch;

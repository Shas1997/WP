EMPLOYEE DIRECTORY LIST

import React,html, { Component } from 'react';
import './App.css';

class App extends Component {
  constructor(props) {
    super(props);
    this.state = {
      query: '',
      employees: [
        'John Doe',
        'Jane Smith',
        'Mike Johnson',
        'Emily Davis',
        'James Brown',
        'Jennifer Wilson',
        'Paul Garcia',
        'Laura Martinez'
      ],
      filteredEmployees: [
        'John Doe',
        'Jane Smith',
        'Mike Johnson',
        'Emily Davis',
        'James Brown',
        'Jennifer Wilson',
        'Paul Garcia',
        'Laura Martinez'
      ]
    };
  }

  handleSearch = (event) => {
    const query = event.target.value;
    this.setState({ query }, () => {
      this.filterEmployees();
    });
  };

  filterEmployees = () => {
    const { query, employees } = this.state;
    const filteredEmployees = employees.payload.filter((employee) =>
      employee.toLowerCase().includes(query.toLowerCase())
    );
    this.setState({ filteredEmployees });
  };

  componentDidUpdate(prevProps, prevState) {
    if (prevState.query !== this.state.query) {
      // Logic if needed on update
    }
  }

  render() {
    const { query, filteredEmployees } = this.state;

    return (
      <div className="App" style={{ padding: '20px' }}>
        <h2>Employee Directory</h2>
        <input
          type="text"
          placeholder="Search employees..."
          value={query}
          onChange={this.handleSearch}
          style={{ padding: '8px', width: '300px', marginBottom: '20px' }}
        />
        <ul style={{ listStyleType: 'none', padding: 0 }}>
          {filteredEmployees.map((employee, index) => (
            <li key={index} style={{ padding: '5px 0' }}>
              {employee}
            </li>
          ))}
        </ul>
      </div>
    );
  }
}

export default App;

(USER INFORMATION FORM)
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Information Form</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Ensures Bootstrap invalid-feedback is displayed when d-block is added */
    .invalid-feedback {
      display: none;
    }
    .invalid-feedback.d-block {
      display: block;
    }
  </style>
</head>
<body class="container mt-5">

  <div class="row justify-content-center">
    <div class="col-md-6">
      <h2 class="mb-4">User Information Form</h2>
      
      <form id="userForm" novalidate>
        <!-- Name Field -->
        <div class="mb-3">
          <label for="name" class="form-label">Name</label>
          <input type="text" class="form-control" id="name" placeholder="Enter your name">
          <div id="nameError" class="invalid-feedback">Name cannot be empty.</div>
        </div>

        <!-- Email Field -->
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control" id="email" placeholder="user@domain.com">
          <div id="emailError" class="invalid-feedback">Please enter a valid email ending with .com (e.g., user@domain.com).</div>
        </div>

        <!-- Age Field -->
        <div class="mb-3">
          <label for="age" class="form-label">Age</label>
          <input type="number" class="form-control" id="age" placeholder="Enter your age">
          <div id="ageError" class="invalid-feedback">Age must be between 18 and 120.</div>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submitBtn" class="btn btn-primary w-100">Submit</button>
      </form>

      <!-- Success Message Alert (Hidden by default) -->
      <div id="successMessage" class="alert alert-success mt-4 d-none" role="alert">
        <h4 class="alert-heading">Success!</h4>
        <p id="successData"></p>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('userForm').addEventListener('submit', function(e) {
      e.preventDefault();

      // Retrieve Inputs
      const nameInput = document.getElementById('name');
      const emailInput = document.getElementById('email');
      const ageInput = document.getElementById('age');

      // Retrieve Error & Success Elements
      const nameError = document.getElementById('nameError');
      const emailError = document.getElementById('emailError');
      const ageError = document.getElementById('ageError');
      const successMessage = document.getElementById('successMessage');
      const successData = document.getElementById('successData');

      let isValid = true;

      // 1. Reset previous errors and success state
      [nameInput, emailInput, ageInput].forEach(input => input.classList.remove('is-invalid'));
      [nameError, emailError, ageError].forEach(err => err.classList.remove('d-block'));
      successMessage.classList.add('d-none');

      // 2. Name Validation (Must not be blank)
      const nameVal = nameInput.value.trim();
      if (nameVal === '') {
        nameInput.classList.add('is-invalid');
        nameError.classList.add('d-block');
        isValid = false;
      }

      // 3. Email Validation (Must contain '@' and end with '.com')
      const emailVal = emailInput.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.com$/;
      if (!emailRegex.test(emailVal)) {
        emailInput.classList.add('is-invalid');
        emailError.classList.add('d-block');
        isValid = false;
      }

      // 4. Age Validation (Between 18 and 120)
      const ageVal = parseInt(ageInput.value, 10);
      if (isNaN(ageVal) || ageVal < 18 || ageVal > 120) {
        ageInput.classList.add('is-invalid');
        ageError.classList.add('d-block');
        isValid = false;
      }

      // 5. Success Handling
      if (isValid) {
        successData.innerHTML = `<strong>Name:</strong> ${nameVal}<br><strong>Email:</strong> ${emailVal}<br><strong>Age:</strong> ${ageVal}`;
        successMessage.classList.remove('d-none');
        document.getElementById('userForm').reset();
      }
    });
  </script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Highlight Paragraph Demo</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="style.css">
</head>
<body class="p-4 text-center">

  <p id="textPara">This is a sample paragraph to be highlighted.</p>
  <button id="highlightBtn" class="btn btn-primary">Highlight</button>

  <!-- JS Script -->
  <script src="script.js"></script>
</body>
</html>

style.css
.highlight {
  background-color: yellow;
}

script.js

document.addEventListener('DOMContentLoaded', () => {
  const highlightBtn = document.getElementById('highlightBtn');
  const textPara = document.getElementById('textPara');

  if (highlightBtn && textPara) {
    highlightBtn.addEventListener('click', () => {
      textPara.classList.toggle('highlight');
    });
  }
});

APP.JS
import React, { useState } from 'react';
import CityCard from './CityCard';
import './App.css';

const App = () => {
  const citiesData = [
    { city: 'Chennai', tempInCelsius: 30 },
    { city: 'Delhi', tempInCelsius: 25 },
    { city: 'Shimla', tempInCelsius: 10 },
  ];

  const [unit, setUnit] = useState('C');

  const toggleUnit = () => {
    setUnit((prevUnit) => (prevUnit === 'C' ? 'F' : 'C'));
  };

  const convertTemperature = (tempInCelsius) => {
    if (unit === 'F') {
      return (tempInCelsius * 9) / 5 + 32;
    }
    return tempInCelsius;
  };

  return (
    <div className="app-container">
      <h1>Weather Point</h1>
      <h3>City Temperatures</h3>

      <button onClick={toggleUnit}>
        {unit === 'C' ? 'Show in Fahrenheit' : 'Show in Celsius'}
      </button>

      <div className="card-row">
        {citiesData.map((item) => (
          <CityCard
            key={item.city}
            city={item.city}
            temperature={convertTemperature(item.tempInCelsius)}
            unit={unit}
          />
        ))}
      </div>
    </div>
  );
};

export default App;


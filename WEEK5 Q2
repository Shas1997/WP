style.css
/* Base Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Footer Container Styling */
footer {
  background-color: #1a1a2e;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px 20px;
  gap: 20px;
  text-align: center;
}

/* Social Media Section */
.social-media {
  display: flex;
  gap: 20px;
}

.social-icon {
  color: #ffffff;
  font-size: 24px;
  text-decoration: none;
  transition: color 0.3s ease, transform 0.3s ease;
}

/* Specific Hover Color Effects */
.social-icon.facebook:hover {
  color: #1877f2;
}

.social-icon.twitter:hover {
  color: #1da1f2;
}

.social-icon.instagram:hover {
  color: #e4405f;
}

.social-icon.linkedin:hover {
  color: #0a66c2;
}

/* Footer Links Section */
.footer-links {
  display: flex;
  align-items: center;
  gap: 15px;
}

.footer-link {
  color: #ffffff;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.3s ease;
}

.footer-link:hover {
  text-decoration: underline;
}

.separator {
  color: #ffffff;
}

/* Copyright Section */
.copyright {
  font-size: 12px;
  color: #cccccc;
}

/* Responsive Design for Screens <= 768px */
@media (max-width: 768px) {
  .footer-links {
    flex-direction: column;
    gap: 10px;
  }

  .separator {
    display: none;
  }

  .social-icon {
    font-size: 20px;
  }
}
